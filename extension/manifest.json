{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "manifest_version": 3,
  "name": "Verdict Helper",
  "description": "One-click submission to Codeforces - the modern competitive programming interface helper.",
  "version": "1.4.0",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "*://codeforces.com/*",
    "*://*.codeforces.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://icpchue.com/*",
        "*://*.icpchue.com/*",
        "*://icpchue.xyz/*",
        "*://*.icpchue.xyz/*",
        "*://verdict.run/*",
        "*://*.verdict.run/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://codeforces.com/contest/*/submit*",
        "*://codeforces.com/gym/*/submit*",
        "*://codeforces.com/group/*/contest/*/submit*",
        "*://www.codeforces.com/contest/*/submit*",
        "*://www.codeforces.com/gym/*/submit*",
        "*://www.codeforces.com/group/*/contest/*/submit*"
      ],
      "js": [
        "cf-submit-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://codeforces.com/contest/*/submit*",
        "*://codeforces.com/gym/*/submit*",
        "*://codeforces.com/group/*/contest/*/submit*",
        "*://www.codeforces.com/contest/*/submit*",
        "*://www.codeforces.com/gym/*/submit*",
        "*://www.codeforces.com/group/*/contest/*/submit*"
      ],
      "js": [
        "cf-submit.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Verdict Helper - Codeforces Submission",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "logo.webp"
      ],
      "matches": [
        "*://icpchue.com/*",
        "*://*.icpchue.com/*",
        "*://icpchue.xyz/*",
        "*://*.icpchue.xyz/*",
        "*://verdict.run/*",
        "*://*.verdict.run/*"
      ]
    }
  ],
  "minimum_chrome_version": "116"
}
